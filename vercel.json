{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ecovision-ai/frontend && npm install && npm run build",
  "outputDirectory": "ecovision-ai/frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
